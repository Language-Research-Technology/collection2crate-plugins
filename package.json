{
  "name": "collection2crate-plugins",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Build plugins for collection2crate — hook-tap plugins, including the builders that assemble the crate, split out of collection2crate's src/plugins/ into their own repo; each lives in plugins/<name>/.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "ro-crate": "^3.7.2",
    "ro-crate-excel": "^1.2.1",
    "roctable": "github:ptsefton/roctable#3b4c5dca3f5c92f452b7bb664d097f5ceafcf137",
    "unicode-name": "^1.1.0"
  },
  "scripts": {
    "test": "node hooks.test.mjs",
    "test:hooks": "node hooks.test.mjs",
    "update:pronom": "node plugins/file-format-identify/update-sf-wasm.mjs",
    "test:pronom": "node plugins/file-format-identify/matcher.test.mjs"
  }
}
